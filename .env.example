# ==========================================
# OmniSpace Environment Configuration
# ==========================================

# Database URL:
# SQLite by default:
DATABASE_URL="sqlite:///./omnispace.db"
# PostgreSQL alternative example:
# DATABASE_URL="postgresql://username:password@localhost:5432/omnispace"

# Security & Authentication
JWT_SECRET="super-secret-omnispace-jwt-key-change-in-production-random-hash"

# App & Server Ports
PORT=3000
BACKEND_PORT=8000

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Uploads directory
UPLOAD_DIR="./uploads"

# Optional Cloud Run or Hosting URL
APP_URL="http://localhost:3000"
